        "yaml-preview-enhanced.schema": {
          "type": "string",
          "default": "",
          "markdownDescription": "%yaml-preview-enhanced.schema.markdownDescription%"
        },
        "yaml-preview-enhanced.schemas": {
          "type": "object",
          "default": {},
          "markdownDescription": "%yaml-preview-enhanced.schemas.markdownDescription%",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "yaml-preview-enhanced.allowRemoteSchemas": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.allowRemoteSchemas.markdownDescription%",
          "scope": "machine"
