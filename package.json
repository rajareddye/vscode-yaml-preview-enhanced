        "yaml-preview-enhanced.publishDiagnostics": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.publishDiagnostics.markdownDescription%"
        },
        "yaml-preview-enhanced.printBackground": {
