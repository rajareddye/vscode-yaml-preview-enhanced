    "configuration": {
      "title": "yaml-preview-enhanced-r",
      "properties": {
        "yaml-preview-enhanced.previewMode": {
          "type": "string",
          "default": "Single Preview",
          "markdownDescription": "%yaml-preview-enhanced.previewMode.markdownDescription%",
          "enum": [
            "Single Preview",
            "Multiple Previews",
            "Previews Only"
          ],
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.previewMode.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.previewMode.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.previewMode.markdownEnumDescriptions.2%"
          ]
        },
        "yaml-preview-enhanced.scrollSync": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.scrollSync.markdownDescription%"
        },
        "yaml-preview-enhanced.liveUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.liveUpdate.markdownDescription%"
        },
        "yaml-preview-enhanced.liveUpdateDebounceMs": {
          "type": "number",
          "default": 300,
          "markdownDescription": "%yaml-preview-enhanced.liveUpdateDebounceMs.markdownDescription%",
          "minimum": 0,
          "maximum": 5000
        },
        "yaml-preview-enhanced.automaticallyShowPreviewOfYamlBeingEdited": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.automaticallyShowPreviewOfYamlBeingEdited.markdownDescription%"
        },
        "yaml-preview-enhanced.disableAutoPreviewForUriSchemes": {
          "type": "array",
          "default": [
            "vscode-notebook-cell"
          ],
          "markdownDescription": "%yaml-preview-enhanced.disableAutoPreviewForUriSchemes.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.disableAutoPreviewForFilePatterns": {
          "type": "array",
          "default": [],
          "markdownDescription": "%yaml-preview-enhanced.disableAutoPreviewForFilePatterns.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.yamlFileExtensions": {
          "type": "array",
          "default": [
            ".yaml",
            ".yml"
          ],
          "markdownDescription": "%yaml-preview-enhanced.yamlFileExtensions.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.maxFileSize": {
          "type": "number",
          "default": 5242880,
          "markdownDescription": "%yaml-preview-enhanced.maxFileSize.markdownDescription%",
          "minimum": 0
        },
        "yaml-preview-enhanced.previewColorScheme": {
          "type": "string",
          "default": "selectedPreviewTheme",
          "markdownDescription": "%yaml-preview-enhanced.previewColorScheme.markdownDescription%",
          "enum": [
            "selectedPreviewTheme",
            "systemColorScheme",
            "editorColorScheme"
          ],
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.previewColorScheme.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.previewColorScheme.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.previewColorScheme.markdownEnumDescriptions.2%"
          ]
        },
        "yaml-preview-enhanced.previewTheme": {
          "type": "string",
          "default": "github-light",
          "markdownDescription": "%yaml-preview-enhanced.previewTheme.markdownDescription%",
          "enum": [
            "github-light",
            "github-dark",
            "one-light",
            "one-dark",
            "solarized-light",
            "solarized-dark",
            "monokai",
            "dracula"
          ]
        },
        "yaml-preview-enhanced.defaultView": {
          "type": "string",
          "default": "tree",
          "markdownDescription": "%yaml-preview-enhanced.defaultView.markdownDescription%",
          "enum": [
            "tree",
            "document",
            "json",
            "resolved"
          ],
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.defaultView.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.defaultView.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.defaultView.markdownEnumDescriptions.2%",
            "%yaml-preview-enhanced.defaultView.markdownEnumDescriptions.3%"
          ]
        },
        "yaml-preview-enhanced.defaultExpandDepth": {
          "type": "number",
          "default": 4,
          "markdownDescription": "%yaml-preview-enhanced.defaultExpandDepth.markdownDescription%",
          "minimum": 0,
          "maximum": 99
        },
        "yaml-preview-enhanced.showComments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.showComments.markdownDescription%"
        },
        "yaml-preview-enhanced.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.showLineNumbers.markdownDescription%"
        },
        "yaml-preview-enhanced.showTypeBadges": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.showTypeBadges.markdownDescription%"
        },
        "yaml-preview-enhanced.autoTables": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.autoTables.markdownDescription%"
        },
        "yaml-preview-enhanced.sortKeys": {
          "type": "string",
          "default": "none",
          "markdownDescription": "%yaml-preview-enhanced.sortKeys.markdownDescription%",
          "enum": [
            "none",
            "asc",
            "desc"
          ]
        },
        "yaml-preview-enhanced.maskKeys": {
          "type": "array",
          "default": [],
          "markdownDescription": "%yaml-preview-enhanced.maskKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.enablePreviewZenMode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.enablePreviewZenMode.markdownDescription%"
        },
        "yaml-preview-enhanced.enablePreviewContextMenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.enablePreviewContextMenu.markdownDescription%"
        },
        "yaml-preview-enhanced.useVSCodeThemeForContextMenu": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.useVSCodeThemeForContextMenu.markdownDescription%"
        },
        "yaml-preview-enhanced.renderMarkdownInStrings": {
          "type": "string",
          "default": "off",
          "markdownDescription": "%yaml-preview-enhanced.renderMarkdownInStrings.markdownDescription%",
          "enum": [
            "off",
            "byKey",
            "all"
          ],
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.renderMarkdownInStrings.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.renderMarkdownInStrings.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.renderMarkdownInStrings.markdownEnumDescriptions.2%"
          ]
        },
        "yaml-preview-enhanced.markdownKeys": {
          "type": "array",
          "default": [
            "description",
            "summary",
            "notes",
            "readme",
            "body",
            "details",
            "text",
            "content",
            "message",
            "help",
            "doc",
            "docs",
            "documentation",
            "about"
          ],
          "markdownDescription": "%yaml-preview-enhanced.markdownKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.breakOnSingleNewLine": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.breakOnSingleNewLine.markdownDescription%"
        },
        "yaml-preview-enhanced.enableTypographer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%yaml-preview-enhanced.enableTypographer.markdownDescription%"
        },
        "yaml-preview-enhanced.enableLinkify": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.enableLinkify.markdownDescription%"
        },
        "yaml-preview-enhanced.protocolsWhiteList": {
          "type": "string",
          "default": "http://, https://, mailto:, tel:",
          "markdownDescription": "%yaml-preview-enhanced.protocolsWhiteList.markdownDescription%"
        },
        "yaml-preview-enhanced.imagePreview": {
          "type": "string",
          "default": "local",
          "markdownDescription": "%yaml-preview-enhanced.imagePreview.markdownDescription%",
          "enum": [
            "off",
            "local",
            "all"
          ],
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.imagePreview.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.imagePreview.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.imagePreview.markdownEnumDescriptions.2%"
          ]
        },
        "yaml-preview-enhanced.enableImageLightbox": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.enableImageLightbox.markdownDescription%"
        },
        "yaml-preview-enhanced.documentTitleKeys": {
          "type": "array",
          "default": [
            "id",
            "title",
            "name",
            "heading",
            "label"
          ],
          "markdownDescription": "%yaml-preview-enhanced.documentTitleKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.documentMetadataKeys": {
          "type": "array",
          "default": [
            "metadata",
            "meta",
            "attributes",
            "properties",
            "info"
          ],
          "markdownDescription": "%yaml-preview-enhanced.documentMetadataKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.documentTextKeys": {
          "type": "array",
          "default": [
            "text",
            "description",
            "content",
            "body",
            "statement",
            "rationale",
            "summary",
            "details",
            "notes",
            "comment",
            "message",
            "requirement"
          ],
          "markdownDescription": "%yaml-preview-enhanced.documentTextKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.documentFlattenKeys": {
          "type": "array",
          "default": [
            "content",
            "children",
            "items",
            "sections",
            "blocks",
            "elements",
            "entries"
          ],
          "markdownDescription": "%yaml-preview-enhanced.documentFlattenKeys.markdownDescription%",
          "items": {
            "type": "string"
          }
        },
        "yaml-preview-enhanced.plantumlEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.plantumlEnabled.markdownDescription%"
        },
        "yaml-preview-enhanced.plantumlJarPath": {
          "type": "string",
          "default": "/usr/local/bin/plantuml.jar",
          "markdownDescription": "%yaml-preview-enhanced.plantumlJarPath.markdownDescription%",
          "scope": "machine"
        },
        "yaml-preview-enhanced.javaPath": {
          "type": "string",
          "default": "java",
          "markdownDescription": "%yaml-preview-enhanced.javaPath.markdownDescription%",
          "scope": "machine"
        },
        "yaml-preview-enhanced.plantumlSecurityProfile": {
          "type": "string",
          "default": "SANDBOX",
          "markdownDescription": "%yaml-preview-enhanced.plantumlSecurityProfile.markdownDescription%",
          "enum": [
            "SANDBOX",
            "INTERNET",
            "LEGACY",
            "UNSECURE"
          ],
          "scope": "machine",
          "markdownEnumDescriptions": [
            "%yaml-preview-enhanced.plantumlSecurityProfile.markdownEnumDescriptions.0%",
            "%yaml-preview-enhanced.plantumlSecurityProfile.markdownEnumDescriptions.1%",
            "%yaml-preview-enhanced.plantumlSecurityProfile.markdownEnumDescriptions.2%",
            "%yaml-preview-enhanced.plantumlSecurityProfile.markdownEnumDescriptions.3%"
