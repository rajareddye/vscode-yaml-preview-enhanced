{
  "name": "yaml-preview-enhanced-r",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "rajareddye",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "categories": [
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "yaml",
    "yml",
    "preview",
    "viewer",
    "tree",
    "json schema",
    "kubernetes",
    "openapi",
    "docker compose",
    "github actions",
    "anchors",
    "export"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rajareddye/vscode-yaml-preview-enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/rajareddye/vscode-yaml-preview-enhanced/issues"
  },
  "homepage": "https://github.com/rajareddye/vscode-yaml-preview-enhanced#readme",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/native/extension.js",
  "browser": "./out/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml",
    "onLanguage:dockercompose",
    "onLanguage:github-actions-workflow",
    "onLanguage:ansible",
    "onLanguage:azure-pipelines",
    "onLanguage:home-assistant"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Local-only features (PDF/PNG export, config scripts, open in browser) are unavailable in virtual workspaces."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Settings that point at executables or scripts, and workspace-level scripts, are ignored in untrusted workspaces.",
      "restrictedConfigurations": [
        "yaml-preview-enhanced.chromePath",
        "yaml-preview-enhanced.chromeArgs",
        "yaml-preview-enhanced.configPath",
        "yaml-preview-enhanced.enableScriptExecution",
        "yaml-preview-enhanced.allowRemoteSchemas",
        "yaml-preview-enhanced.plantumlJarPath",
        "yaml-preview-enhanced.javaPath",
        "yaml-preview-enhanced.plantumlArgs",
        "yaml-preview-enhanced.plantumlSecurityProfile"
      ]
    }
  },
