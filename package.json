        },
        "yaml-preview-enhanced.plantumlTimeoutMs": {
          "type": "number",
          "default": 30000,
          "markdownDescription": "%yaml-preview-enhanced.plantumlTimeoutMs.markdownDescription%",
          "minimum": 1000,
          "maximum": 300000
