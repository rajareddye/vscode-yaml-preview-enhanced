        "yaml-preview-enhanced.uniqueKeys": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.uniqueKeys.markdownDescription%"
        },
        "yaml-preview-enhanced.ignoreUnknownTagWarnings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%yaml-preview-enhanced.ignoreUnknownTagWarnings.markdownDescription%"
