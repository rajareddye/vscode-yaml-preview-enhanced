        "yaml-preview-enhanced.plantumlArgs": {
          "type": "array",
          "default": [],
          "markdownDescription": "%yaml-preview-enhanced.plantumlArgs.markdownDescription%",
          "items": {
            "type": "string"
          },
          "scope": "machine"
        },
        "yaml-preview-enhanced.plantumlKeys": {
          "type": "array",
          "default": [
            "plantuml",
            "puml",
            "uml"
          ],
          "markdownDescription": "%yaml-preview-enhanced.plantumlKeys.markdownDescription%",
          "items": {
            "type": "string"
