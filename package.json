  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "check:all": "pnpm check:eslint && pnpm check:prettier && pnpm typecheck",
    "check:eslint": "eslint \"**/*\"",
    "check:prettier": "prettier --check \"**/*.*\"",
    "fix:all": "pnpm fix:eslint && pnpm fix:prettier",
    "fix:eslint": "eslint --fix \"**/*\"",
    "fix:prettier": "prettier --write \"**/*.*\"",
    "prepare": "husky",
    "test": "pnpm build && mocha --ui tdd --reporter spec \"test/**/*.test.js\"",
    "test:unit": "mocha --ui tdd --reporter spec \"test/**/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build"
  },
